# Values come from `firebase apps:sdkconfig web <appId> --project cloud-sa-sandbox-1`. Copy to .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cloud-sa-sandbox-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cloud-sa-sandbox-1
VITE_FIREBASE_APP_ID=
# Restricts the Google sign-in popup to one Workspace domain (hint only; the backend enforces it)
VITE_ALLOWED_DOMAIN=ikala.ai
# 1 = keep the self-contained prototype behaviour (fake login, seeded data), no backend needed
VITE_MOCK_API=1
# Where `npm run dev` proxies /api (a local backend, or the deployed Cloud Run URL)
API_PROXY_TARGET=http://localhost:8080
# Connectors catalog logos: official logos are bundled offline. For services without one, the catalog may fall back to the
# site's public favicon via https://www.google.com/s2/favicons (the browser then asks Google for that icon).
# Set to 0 to keep the catalog fully offline (monogram instead).
VITE_ICON_FAVICON_FALLBACK=1
