    "highlight.js": "^11.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.2"
