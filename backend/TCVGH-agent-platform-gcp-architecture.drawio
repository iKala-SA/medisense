        <mxCell id="gws" value="Google Workspace (TCVGH tenant)&#xa;identity provider for sign-in; Gmail, Calendar,&#xa;Drive, Docs APIs via internal OAuth app&#xa;(no external app verification needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1575" y="355" width="230" height="75" as="geometry"/></mxCell>
