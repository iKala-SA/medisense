        <mxCell id="saas" value="Connected applications (MVP = Google Workspace only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#188038;dashed=0;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#188038;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1560" y="320" width="260" height="300" as="geometry"/></mxCell>
        <mxCell id="onprem" value="TCVGH on-premises datacenter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#5F6368;dashed=0;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#5F6368;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1560" y="680" width="260" height="370" as="geometry"/></mxCell>
        <mxCell id="builder" value="TCVGH employee&#xa;(agent builder)" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="50" height="70" as="geometry"/></mxCell>
        <mxCell id="enduser" value="End users (staff)&#xa;web chat / Google Chat" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="50" height="70" as="geometry"/></mxCell>
        <mxCell id="admin" value="Platform admin /&#xa;IT security &amp; compliance" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="50" height="70" as="geometry"/></mxCell>
        <mxCell id="hosting" value="Firebase Hosting&#xa;Agent Builder web app (React)&#xa;- left panel: name, description, instructions,&#xa;  model, routing policy, connectors&#xa;- center: drag &amp; drop canvas (React Flow)&#xa;- right: test chat / run preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F9AB00;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="285" y="145" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="fbauth" value="Firebase Authentication (Identity Platform)&#xa;Google sign-in only, restricted to the TCVGH&#xa;Workspace domain (hd claim + blocking function);&#xa;roles via custom claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F9AB00;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="285" y="290" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="appcheck" value="Firebase App Check&#xa;(reCAPTCHA Enterprise) blocks&#xa;non-app API traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F9AB00;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="285" y="395" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="lb" value="Cloud Load Balancing&#xa;+ Cloud Armor (WAF, rate limit)" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_load_balancing;" vertex="1" parent="1"><mxGeometry x="350" y="480" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="noteA" value="Hosting rewrites /api/* to Cloud Run; Platform API verifies the Firebase ID token and domain. No MFA today: recommend enforcing 2-Step Verification in Workspace Admin, at least for platform admins." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="285" y="600" width="185" height="90" as="geometry"/></mxCell>
        <mxCell id="api" value="Platform API&#xa;agent CRUD, versioning, publish,&#xa;RBAC, approval workflow" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_run;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="channels" value="Channel Adapters&#xa;web chat (SSE), Google Chat app;&#xa;phase 2: LINE, Slack, Teams" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_run;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="runtime" value="Agent Runtime (Google ADK)&#xa;interprets flow JSON, tools,&#xa;session memory, HITL pauses" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_run;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="connector" value="Connector Service&#xa;MCP tool servers, OAuth broker,&#xa;human-in-the-loop approvals" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_run;" vertex="1" parent="1"><mxGeometry x="620" y="570" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="scheduler" value="Cloud Scheduler&#xa;scheduled agents" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_scheduler;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="tasks" value="Cloud Tasks / Pub/Sub&#xa;async runs, doc ingestion&#xa;-&gt; RAG index" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_tasks;" vertex="1" parent="1"><mxGeometry x="680" y="700" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="firestore" value="Firestore (Native mode)&#xa;agents, versions, flows,&#xa;sessions, RBAC, audit" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_firestore;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="gcs" value="Cloud Storage&#xa;uploads (de-identified),&#xa;knowledge docs, exports" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_storage;" vertex="1" parent="1"><mxGeometry x="955" y="150" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="vector" value="Vertex AI RAG Engine / Vector Search&#xa;per-agent knowledge base (optional);&#xa;queried by Agent Runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="805" y="290" width="205" height="60" as="geometry"/></mxCell>
        <mxCell id="secrets" value="Secret Manager&#xa;connector OAuth refresh tokens,&#xa;model provider API keys (never in Firestore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="805" y="500" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="cloudsql" value="Cloud SQL (Postgres)&#xa;LiteLLM keys, spend logs" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_sql;" vertex="1" parent="1"><mxGeometry x="830" y="640" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="redis" value="Memorystore (Redis)&#xa;router state, cache" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_memorystore;" vertex="1" parent="1"><mxGeometry x="955" y="640" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="bq" value="BigQuery&#xa;usage, spend per agent,&#xa;quality evals, audit analytics" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="1"><mxGeometry x="830" y="765" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="litellm" value="LiteLLM Proxy (Cloud Run, min 1 instance)&#xa;- one OpenAI-compatible endpoint for all models&#xa;- virtual key + budget per agent / department&#xa;- router: fallbacks, load-balance, latency, cooldown&#xa;- providers: Vertex AI, Azure OpenAI, Bedrock, on-prem vLLM&#xa;- model groups: fast / reasoning / budget / sovereign&#xa;- sovereign =&gt; on-prem only, fail closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1060" y="145" width="195" height="120" as="geometry"/></mxCell>
        <mxCell id="guard" value="Sensitive Data Protection (de-identify) + Model Armor&#xa;every upload and prompt is pseudonymized (deterministic&#xa;encryption, KMS-held key) before storage or any model call;&#xa;re-identify only via authorized role. Prompt-injection screening." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="195" height="80" as="geometry"/></mxCell>
        <mxCell id="taskrouter" value="Model routing policy (set per agent in builder)&#xa;rules + light classifier: task type, sensitivity, cost tier&#xa;-&gt; model group + failover chain, e.g. fast / reasoning /&#xa;budget / sovereign" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1060" y="420" width="195" height="75" as="geometry"/></mxCell>
        <mxCell id="noteD" value="Model groups (TCVGH list): fast = Gemini 3 Flash | gpt-oss-20b; reasoning = Gemini 3.1 Pro | Claude Sonnet 4.6 | gpt-oss-120b; budget = Claude Haiku 4.5 | Nova 2 Lite | Gemma 4 26B; sovereign = on-prem only. GPT-5 kept as TMMLU+ benchmark reference." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1060" y="650" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="vertex" value="Vertex AI (global endpoint*)&#xa;Gemini 3 Flash / 3.1 Pro (preview IDs), Gemini 2.5&#xa;*no Gemini served from asia-east1 (verified 2026-10-23)&#xa;option: Claude on Vertex; Private Service Connect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1300" y="145" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="garden" value="Phase 3 option: Vertex AI self-deployed&#xa;open-model endpoints (GPU) if on-prem&#xa;capacity runs out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1300" y="260" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="vpn" value="Cloud VPN (HA) or&#xa;Dedicated Interconnect&#xa;+ Cloud Router (BGP)" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_vpn;" vertex="1" parent="1"><mxGeometry x="1365" y="700" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="noteE" value="Hybrid link carries only LiteLLM -&gt; on-prem model calls (private IPs, mTLS). If on-prem is down, sovereign agents fail closed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1300" y="800" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="iam" value="Cloud IAM +&#xa;least-privilege SAs" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_iam;" vertex="1" parent="1"><mxGeometry x="290" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="kms" value="Cloud KMS (CMEK)&#xa;Firestore, GCS, SQL" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.key_management_service;" vertex="1" parent="1"><mxGeometry x="395" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="vpcsc" value="VPC Service Controls&#xa;perimeter: Firestore, GCS,&#xa;Vertex AI, Secret Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="490" y="935" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="orgpol" value="Org Policy&#xa;resource location = asia-east1,&#xa;no public IPs, domain-restricted sharing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="665" y="935" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="audit" value="Cloud Audit Logs&#xa;+ Data Access logs, long-term&#xa;retention bucket (locked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="845" y="935" width="165" height="60" as="geometry"/></mxCell>
        <mxCell id="logging" value="Cloud Logging" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.logging;" vertex="1" parent="1"><mxGeometry x="1050" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="monitoring" value="Cloud Monitoring&#xa;+ alerting" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.monitoring;" vertex="1" parent="1"><mxGeometry x="1140" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="trace" value="Cloud Trace&#xa;(OpenTelemetry)" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.trace;" vertex="1" parent="1"><mxGeometry x="1230" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="build" value="Cloud Build&#xa;CI/CD" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.cloud_build;" vertex="1" parent="1"><mxGeometry x="1320" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="registry" value="Artifact Registry&#xa;+ Terraform IaC" style="html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=10;fontColor=#202124;shape=mxgraph.gcp2.container_registry;" vertex="1" parent="1"><mxGeometry x="1410" y="940" width="50" height="50" as="geometry"/></mxCell>
        <mxCell id="openai" value="Azure OpenAI: GPT-5.4 (Data Zone deployment)&#xa;Entra app / API key in Secret Manager; budget caps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1575" y="120" width="230" height="50" as="geometry"/></mxCell>
