        <mxCell id="region" value="Region asia-east1 (Taiwan)  -  data at rest in-region; every cloud model receives de-identified text only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1A73E8;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#1A73E8;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="250" y="85" width="1250" height="795" as="geometry"/></mxCell>
