        <mxCell id="colC" value="C. Data &amp; knowledge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F8FF;strokeColor=#4285F4;dashed=0;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#4285F4;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="235" height="750" as="geometry"/></mxCell>
