        <mxCell id="line" value="Phase 2 (not in MVP): Slack, LINE Messaging API,&#xa;Microsoft 365 / Teams connectors and channels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1575" y="525" width="230" height="50" as="geometry"/></mxCell>
        <mxCell id="onprem_llm" value="On-prem inference (existing, 1x H200, operator TBD)&#xa;OpenAI-compatible server (vLLM)&#xa;now: gpt-oss-20b, Gemma 4 26B-A4B&#xa;upgrade: gpt-oss-120b, Gemma 4 31B dense&#xa;Llama 3.3 70B needs 1-2x H200; capacity-limited&#xa;=&gt; LiteLLM rpm/tpm caps, cloud overflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1575" y="715" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="his" value="HIS / EMR / PACS (PHI systems)&#xa;stay on-prem; NOT connected to the platform.&#xa;PHI reaches an agent only if a user uploads it,&#xa;and it is de-identified at ingress (option B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=10;fontColor=#202124;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1575" y="835" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="noteOn" value="PHI boundary: identified patient data is never persisted in GCP (pseudonymized at ingress); hybrid link carries only model calls." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1575" y="920" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;dashed=0;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#5F6368;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="180" height="170" as="geometry"/></mxCell>
