                <mxCell id="title" value="TCVGH Agent Platform on Google Cloud  -  no-code agent builder  (MVP target architecture, v0.3.1 2026-10-23; grey cards = phase 2)" style="text;html=1;align=left;fontStyle=1;fontSize=16;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1100" height="30" as="geometry"/></mxCell>
