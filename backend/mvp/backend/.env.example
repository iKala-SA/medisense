# Local dev only. On Cloud Run these come from --set-env-vars / --set-secrets (infra/04-deploy-backend.sh).
GOOGLE_CLOUD_PROJECT=cloud-sa-sandbox-1
REGION=asia-east1
LITELLM_BASE_URL=http://localhost:4000      # or the Cloud Run URL (needs ID token; see engine/llm.py)
LITELLM_API_KEY=sk-replace-with-master-key
FIRESTORE_DATABASE=tcvgh-agent-platform
UPLOAD_BUCKET=cloud-sa-sandbox-1-tcvgh-agent-uploads
ALLOWED_DOMAINS=ikala.ai
DLP_INSPECT_TEMPLATE=projects/cloud-sa-sandbox-1/locations/global/inspectTemplates/esther-inspect-test   # de-identification is always on
# Knowledge (Vertex AI RAG Engine). asia-east1 is a Preview region; embeddings are multilingual for Chinese docs.
RAG_ENABLED=true
RAG_LOCATION=asia-east1
RAG_EMBEDDING_MODEL=publishers/google/models/text-multilingual-embedding-002
MAX_UPLOAD_MB=25
# Shared secret for POST /api/schedules/tick (header X-Scheduler-Token); empty disables the endpoint.
SCHEDULER_TOKEN=
