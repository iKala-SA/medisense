# Values come from `infra/05-firebase.sh` (firebase apps:sdkconfig). Copy to .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cloud-sa-sandbox-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cloud-sa-sandbox-1
VITE_FIREBASE_APP_ID=
# Restrict the Google sign-in popup to one Workspace domain (hd hint; backend enforces it)
VITE_ALLOWED_DOMAIN=ikala.ai
# Set to 1 to run the UI with in-memory mock data and no sign-in (design review / demos). Never set in CI.
VITE_MOCK_API=0
