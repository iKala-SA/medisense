   "icon": "hub",
   "badge": "MCP Protocol v1.0",
   "available": true,
   "description": "透過 Model Context Protocol 標準呼叫遠端工具 (Tools)。連線測試後自動列出伺服器註冊的工具。",
   "fields": [
    {
     "key": "url",
     "label": "Remote MCP Server URL",
     "kind": "url",
     "required": true,
     "hint": "Streamable HTTP 端點（院內 VPC 或 Cloud Run）。",
     "placeholder": "https://mcp-cardio.vghtc.internal/mcp",
     "options": [],
     "default": null,
     "section": "server"
    },
    {
     "key": "auth_kind",
     "label": "驗證方式",
     "kind": "select",
     "required": false,
     "hint": "",
     "placeholder": "",
     "options": [
      {
       "value": "none",
       "label": "無"
      },
      {
       "value": "bearer",
       "label": "Bearer Token"
      },
      {
       "value": "header",
       "label": "自訂 Header"
      }
     ],
     "default": "bearer",
     "section": "credentials"
    },
    {
     "key": "auth_header",
     "label": "Header 名稱",
     "kind": "text",
     "required": false,
     "hint": "驗證方式為自訂 Header 時使用。",
     "placeholder": "X-API-Key",
     "options": [],
     "default": null,
     "section": "credentials"
    },
    {
     "key": "token",
     "label": "Token / API Key",
     "kind": "secret",
     "required": false,
     "hint": "",
     "placeholder": "",
     "options": [],
     "default": null,
     "section": "credentials"
    }
   ],
   "actions": "dynamic"
  },
  {
   "id": "webhook",
   "label": "Webhook / REST",
   "category": "mcp",
   "protocol": "HTTP JSON Payload",
   "icon": "webhook",
   "badge": "REST",
   "available": true,
   "description": "將 Agent 推論結果以 JSON 推送到任意 HTTP 端點，或呼叫院內 REST API。",
   "fields": [
    {
     "key": "url",
     "label": "Endpoint URL",
     "kind": "secret",
     "required": true,
     "hint": "存於 Secret Manager，不會顯示於連接器清單。含簽章的網址（如 Power Automate 的 sig=）視同密碼。",
     "placeholder": "https://api.vghtc.internal/notify",
     "options": [],
     "default": null,
     "section": "credentials"
    },
    {
     "key": "method",
     "label": "HTTP Method",
     "kind": "select",
     "required": false,
     "hint": "",
     "placeholder": "",
     "options": [
      {
       "value": "POST",
       "label": "POST"
      },
      {
       "value": "PUT",
       "label": "PUT"
      },
      {
       "value": "GET",
       "label": "GET"
      }
     ],
     "default": "POST",
     "section": "server"
    },
    {
     "key": "headers",
     "label": "額外 Headers（JSON）",
     "kind": "textarea",
     "required": false,
     "hint": "",
     "placeholder": "{\"X-Source\": \"tcvgh-agent\"}",
     "options": [],
     "default": null,
     "section": "server"
    },
    {
     "key": "auth_header",
     "label": "驗證 Header 名稱",
     "kind": "text",
     "required": false,
     "hint": "",
     "placeholder": "",
     "options": [],
     "default": "Authorization",
     "section": "credentials"
    },
    {
     "key": "token",
     "label": "驗證 Header 值",
     "kind": "secret",
     "required": false,
     "hint": "例如 Bearer xxxxx；留空則不送驗證。",
     "placeholder": "",
     "options": [],
     "default": null,
     "section": "credentials"
    }
   ],
   "actions": [
    {
     "id": "request",
     "label": "送出請求",
     "args": [
      {
       "key": "payload",
       "label": "Payload（JSON 或文字，可用模板變數）",
       "kind": "textarea"
      }
     ],
     "write": true
    }
   ]
