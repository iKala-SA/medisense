     "options": [],
     "default": null,
     "section": "credentials"
    },
    {
     "key": "bot_token",
     "label": "Bot User OAuth Token",
     "kind": "secret",
     "required": false,
     "hint": "需要 chat:write 權限；設定後可指定任意頻道。",
     "placeholder": "xoxb-…",
     "options": [],
     "default": null,
     "section": "credentials"
    },
    {
     "key": "default_channel",
     "label": "預設頻道",
     "kind": "text",
     "required": false,
     "hint": "",
     "placeholder": "#cardio-alerts",
     "options": [],
     "default": null,
     "section": "server"
    },
    {
     "key": "scopes",
     "label": "院區授權範圍 (OAuth Scopes)",
     "kind": "checkboxes",
     "required": false,
     "hint": "",
     "placeholder": "",
     "options": [
      {
       "value": "chat:write",
       "label": "chat:write · 發送會診通報"
      },
      {
       "value": "channels:read",
       "label": "channels:read · 讀取頻道"
      },
      {
       "value": "files:write",
       "label": "files:write · 傳送去識別化摘要"
      },
      {
       "value": "users:read.email",
       "label": "users:read.email · 院方禁止",
       "disabled": true
      }
     ],
     "default": [
      "chat:write"
     ],
     "section": "credentials"
    }
   ],
   "actions": [
